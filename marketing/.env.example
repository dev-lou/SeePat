# SeePat marketing site — every variable this project reads, and nothing else.
#
# The page is hand-written static HTML, so these are not "runtime config": they
# are stamped into the markup at build time by tools/stamp.mjs, which is the
# only build step there is. Set them in Vercel (Project → Settings →
# Environment Variables) or, locally, in `.env` — a copy of this file.

# The origin the page is served from, with NO trailing slash.
#
# Required in every deliberate deploy: canonical tags, hreflang alternates,
# og:url and every sitemap entry are built from it, so a wrong value here is a
# wrong value in the index. It is also the only way a page made of files knows
# where it lives.
#
#   https://seepat.ph
SITE_URL=

# Where the app itself lives, when that is not the same origin as this page.
# Every "open the app" button points here. Default: SITE_URL.
#   https://app.seepat.ph
APP_URL=

# Published as the contact address in the footer and in the Organization
# structured data. Left empty by default: an invented address is worse than no
# address, so the footer simply omits the line until this is set.
#   hello@seepat.ph
CONTACT_EMAIL=

# Search Console's "HTML tag" verification token (the value of the `content`
# attribute only). When set, the meta tag is stamped into both pages; when
# empty, no tag is written at all.
GOOGLE_SITE_VERIFICATION=
